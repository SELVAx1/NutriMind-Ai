# ── Supabase ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Backend uses service role key (never expose in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Groq (primary LLM) ──
GROQ_API_KEY=gsk_...your-groq-key
GROQ_MODEL_DEFAULT=qwen/qwen3.8-27b
GROQ_MODEL_FAST=qwen/qwen3.8-27b

# ── Google AI Studio (vision + embeddings + fallback) ──
GOOGLE_AI_API_KEY=AIza...your-google-key
GOOGLE_MODEL_DEFAULT=gemini-3.8-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# ── Provider routing ──
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=google
VISION_PROVIDER=google
EMBEDDING_PROVIDER=google

# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
