# ── Supabase ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Backend uses service role key (never expose in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Groq (primary LLM) ──
GROQ_API_KEY=gsk_...your-groq-key
GROQ_MODEL_DEFAULT=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── Google AI Studio (vision + embeddings + fallback) ──
GOOGLE_AI_API_KEY=AIza...your-google-key
GOOGLE_MODEL_DEFAULT=gemini-2.0-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# ── Provider routing ──
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=google
VISION_PROVIDER=google
EMBEDDING_PROVIDER=google

# ── Application ──
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
